# custom grub menu entry
custom_40 (){
source /etc/opt/board.txt
if [[ "$FSTYPE" == "ext4" ]]; then
	FSMOD="ext2"
	ROOT_FSTYPE="rootfstype=ext4"
	CMDLINE="linux /boot/Image ${CONSOLE} rw root=PARTUUID=${ROOT_PARTUUID} rootwait ${ROOT_FSTYPE} fsck.repair=yes ${LOGLEVEL} ${EXTRA}"
	INITRD="initrd /boot/initrd.gz"
	DEVICETREE="devicetree /boot/${FAMILY}/${DTB}.dtb"
elif [[ "$FSTYPE" == "btrfs" ]]; then
	FSMOD="btrfs"
	ROOT_FSTYPE="rootfstype=btrfs rootflags=subvol=@"
	CMDLINE="linux /@/boot/Image ${CONSOLE} rw root=PARTUUID=${ROOT_PARTUUID} rootwait ${ROOT_FSTYPE} fsck.repair=yes ${LOGLEVEL} ${EXTRA}"
	INITRD="initrd /@/boot/initrd.gz"
	DEVICETREE="devicetree /@/boot/${FAMILY}/${DTB}.dtb"
elif [[ "$FSTYPE" == "xfs" ]]; then
	FSMOD="xfs"
	ROOT_FSTYPE="rootfstype=xfs"
	CMDLINE="linux /boot/Image ${CONSOLE} rw root=PARTUUID=${ROOT_PARTUUID} rootwait ${ROOT_FSTYPE} fsck.repair=yes ${LOGLEVEL} ${EXTRA}"
	INITRD="initrd /boot/initrd.gz"
	DEVICETREE="devicetree /boot/${FAMILY}/${DTB}.dtb"
fi
if [[ "$GPT" == "true" ]]; then PTYPE="gpt"; else PTYPE="msdos"; fi
tee -a /etc/grub.d/40_custom <<EOF
menuentry "${DEFAULT_MOTD}" {
	insmod gzio
	insmod part_${PTYPE}
	insmod ${FSMOD}
	echo "Loading kernel ..."
	${CMDLINE}
	echo "Loading ramdisk ..."
	${INITRD}
	echo "Loading devicetree ..."
	${DEVICETREE}
}
EOF
#sed -i "s/^GRUB_DEFAULT=.*/GRUB_DEFAULT=2/" /etc/default/grub
}

# user scripts (stage1 and stage2)
uscripts_pre-stage1 (){
if [[ -f "files/userscripts/uscripts" ]]; then
	source files/userscripts/uscripts
	if [[ `type run_function0` ]] &>/dev/null; then run_function0; fi
fi
}

uscripts_stage1 (){
if [[ -f "files/userscripts/uscripts" ]]; then
	mkdir -p ${P_VALUE}/root/userscripts;
	cp -fr files/userscripts/* ${P_VALUE}/root/userscripts/;
	if [[ -f "${P_VALUE}/root/userscripts/README.md" ]]; then
		rm -f ${P_VALUE}/root/userscripts/README.md;
	fi
	if [[ `type run_function1` ]] &>/dev/null; then run_function1; fi
fi
}

uscripts_stage2 (){
if [[ -f "/root/userscripts/uscripts" ]]; then
	source /root/userscripts/uscripts
	if [[ `type run_function2` ]] &>/dev/null; then
		echo ""
		echo -e "\033[1mRunning user scripts\e[0m ..."
		run_function2
		echo -e "\033[1mDone\e[0m."
	fi
fi
if [[ -e "/root/userscripts" ]]; then rm -fdr /root/userscripts; fi
}

uscripts_fin-stage1 (){
if [[ -f "files/userscripts/uscripts" ]]; then
	source files/userscripts/uscripts
	if [[ `type run_function3` ]] &>/dev/null; then run_function3; fi
fi
}
