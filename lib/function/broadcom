#!/bin/bash

# boot firmware
broadcom_extra_git (){
FIRMWARE="https://github.com/raspberrypi/firmware.git"
rm -fdr firmware
git clone -q --depth=1 --filter=blob:none --sparse  ${FIRMWARE} boot-firmware
cd boot-firmware
git sparse-checkout add boot &> /dev/null
rm -fdr boot/{overlays,*.dtb,kernel*}
mv boot ../firmware
cd ..
rm -fdr boot-firmware
RPI_FW=( "firmware/fixup4.dat" "firmware/fixup4cd.dat" "firmware/fixup4db.dat" "firmware/fixup4x.dat" "firmware/start4.elf" \
	 "firmware/start4cd.elf" "firmware/start4db.elf" "firmware/start4x.elf" "firmware/bootcode.bin" "firmware/fixup.dat" \
	 "firmware/fixup_cd.dat" "firmware/fixup_db.dat" "firmware/fixup_x.dat" "firmware/start.elf" "firmware/start_cd.elf" \
	 "firmware/start_db.elf" "firmware/start_x.elf" )
RPI_FW_CHK="true"

for bins in "${RPI_FW[@]}"; do
	if [[ ! -f "$bins" ]]; then
		echo -e "Error: '$bins' missing."
		RPI_FW_CHK="false"
		break
	fi
done
if "$RPI_FW_CHK"; then
	:;
else
	echo -e "RPI FW Check, Failed."; echo ""
	exit 1
fi
}

# enable additional modules
broadcom_extra_modules (){
if [[ -f "arch/${ARCH}/configs/${LINUX_DEFCONFIG}" ]]; then
	# remove localversion
	if [[ `grep -w "CONFIG_LOCALVERSION=" "arch/${ARCH}/configs/${LINUX_DEFCONFIG}"` ]]; then sed -i 's/CONFIG_LOCALVERSION=/# CONFIG_LOCALVERSION=/g' arch/${ARCH}/configs/${LINUX_DEFCONFIG}; fi
	# hardcode i2c-dev
	if [[ `grep -w "CONFIG_I2C_CHARDEV=m" "arch/${ARCH}/configs/${LINUX_DEFCONFIG}"` ]]; then sed -i 's/CONFIG_I2C_CHARDEV=m/CONFIG_I2C_CHARDEV=y/g' arch/${ARCH}/configs/${LINUX_DEFCONFIG}; fi
	# hardcode device-mapper
	if [[ `grep -w "CONFIG_BLK_DEV_DM=m" "arch/${ARCH}/configs/${LINUX_DEFCONFIG}"` ]]; then sed -i 's/CONFIG_BLK_DEV_DM=m/CONFIG_BLK_DEV_DM=y/g' arch/${ARCH}/configs/${LINUX_DEFCONFIG}; fi
fi

BRCM_MODULES="CONFIG_MODULE_SIG=y CONFIG_CIFS_POSIX=y CONFIG_EFI=y CONFIG_DMI=y CONFIG_SYSFB_SIMPLEFB=y \n
	CONFIG_EFI_ARMSTUB_DTB_LOADER=y CONFIG_EFI_BOOTLOADER_CONTROL=y CONFIG_RESET_ATTACK_MITIGATION=y \n
	CONFIG_NVME_HWMON=y CONFIG_ZRAM_BACKEND_LZ4=y CONFIG_ZRAM_BACKEND_LZ4HC=y CONFIG_ZRAM_BACKEND_ZSTD=y \n
	CONFIG_ZRAM_BACKEND_DEFLATE=y CONFIG_ZRAM_BACKEND_LZO=y CONFIG_DM_UNSTRIPED=m CONFIG_DM_CRYPT=m \n
	CONFIG_DM_SNAPSHOT=m CONFIG_DM_THIN_PROVISIONING=m CONFIG_DM_CACHE=m CONFIG_DM_WRITECACHE=m \n
	CONFIG_DM_EBS=m CONFIG_DM_ERA=m CONFIG_DM_CLONE=m CONFIG_DM_MIRROR=m CONFIG_DM_LOG_USERSPACE=m \n
	CONFIG_DM_RAID=m CONFIG_DM_ZERO=m CONFIG_DM_MULTIPATH=m CONFIG_DM_MULTIPATH_QL=m CONFIG_DM_MULTIPATH_ST=m \n
	CONFIG_DM_MULTIPATH_HST=m CONFIG_DM_MULTIPATH_IOA=m CONFIG_DM_DELAY=m CONFIG_DM_INIT=y CONFIG_DM_UEVENT=y \n
	CONFIG_DM_FLAKEY=m CONFIG_DM_VERITY=m CONFIG_DM_VERITY_VERIFY_ROOTHASH_SIG=y CONFIG_DM_SWITCH=m \n
	CONFIG_DM_LOG_WRITES=m CONFIG_DM_INTEGRITY=m CONFIG_DM_ZONED=m"

if [[ -v "BRCM_MODULES" ]] && [[ ! -z "$BRCM_MODULES" ]]; then
	# insert additional modules
	echo -e ${BRCM_MODULES} | tr ' ' '\n' | tee -a brcm_modlist.txt > /dev/null 2>&1
	for MODLIST in `cat brcm_modlist.txt`; do
		if [[ `grep -w "${MODLIST}" "arch/${ARCH}/configs/${LINUX_DEFCONFIG}"` ]]; then :; else echo "${MODLIST}" >> "arch/${ARCH}/configs/${LINUX_DEFCONFIG}"; fi
		rm -f brcm_modlist.txt
	done
fi
}

broadcom_extra_git_patching (){
if [[ -f "arch/${ARCH}/Kconfig" ]] && [[ "$ARCH" == "arm64" ]]; then
	# REVERT: arm64/Kconfig: Don't set DMA_BOUNCE_UNALIGNED_KMALLOC
	# If enabled, DMA_BOUNCE_UNALIGNED_KMALLOC causes the swiotlb buffers (64MB, by default) to be allocated, even on systems
	# where the DMA controller can reach all of RAM.
	sed -i 's/	# select DMA_BOUNCE_UNALIGNED_KMALLOC/	select DMA_BOUNCE_UNALIGNED_KMALLOC/g' arch/arm64/Kconfig
fi
if [[ -f "../../${LPATCHESALL}/${LINUX_VERSION}/002-scripts-Makefile.package-PHONY-intdeb-pkg.patch" ]]; then
	for i in ../../${LPATCHESALL}/${LINUX_VERSION}/002-scripts-Makefile.package-PHONY-intdeb-pkg.patch; do patch -N -p1 < $i; done >> ${LOG_FILE}
fi
}

