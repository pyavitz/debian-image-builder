rm -fdr firmware/{.git,README.md}; cp -fr firmware/* /lib/firmware/updates; rm -fdr firmware
}

# rpi-eeprom
find_eeprom (){
EEPROM_VERSION=$(curl --silent -L ${CHANGELOG} | awk '{if (NR==1) {print substr($2, 1, length($2)-3)}}' | sed 's/[()]//g')
if [[ `wget -S --spider ${ERURL}rpi-eeprom_${EEPROM_VERSION}.orig.tar.gz 2>&1 | grep 'HTTP/1.1 200 OK'` ]]; then
	wget -cq --show-progress ${ERURL}rpi-eeprom_${EEPROM_VERSION}-1_all.deb
	wget -cq --show-progress ${ERURL}rpi-eeprom-images_${EEPROM_VERSION}-1_all.deb
else
	EEPROM_VERSION=$(curl --silent -L ${CHANGELOG} | awk '{if (NR==10) {print substr($2, 1, length($2)-3)}}' | sed 's/[()]//g')
	if [[ `wget -S --spider ${ERURL}rpi-eeprom_${EEPROM_VERSION}.orig.tar.gz 2>&1 | grep 'HTTP/1.1 200 OK'` ]]; then
		wget -cq --show-progress ${ERURL}rpi-eeprom_${EEPROM_VERSION}-1_all.deb
		wget -cq --show-progress ${ERURL}rpi-eeprom-images_${EEPROM_VERSION}-1_all.deb
	else
		EEPROM_VERSION="28.8"
		wget -cq --show-progress ${ERURL}rpi-eeprom_${EEPROM_VERSION}-1_all.deb
		wget -cq --show-progress ${ERURL}rpi-eeprom-images_${EEPROM_VERSION}-1_all.deb
	fi
fi
}

eeprom_support (){
echo ""
apt install binutils flashrom pciutils python3 python3-pycryptodome -y
ERURL="https://archive.raspberrypi.org/debian/pool/main/r/rpi-eeprom/"
CHANGELOG="https://raw.githubusercontent.com/raspberrypi/rpi-eeprom/pios/trixie/debian/changelog"
mkdir -p ~/eeprom; cd ~/eeprom
find_eeprom
CTRL=`ar t rpi-eeprom_${EEPROM_VERSION}-1_all.deb | grep "control"`
if [[ -f "rpi-eeprom_${EEPROM_VERSION}-1_all.deb" ]]; then
	ar x rpi-eeprom_${EEPROM_VERSION}-1_all.deb; rm -f {data.tar.xz,debian-binary}
	mkdir tmp; mv ${CTRL} tmp/; cd tmp
	tar xf ${CTRL}; rm ${CTRL}
	sed -i "s/^Depends.*/Depends: python3, binutils, pciutils, python3-pycryptodome/" control
	tar -cJf ${CTRL} *
	mv ${CTRL} ../; cd ..
	ar r rpi-eeprom_${EEPROM_VERSION}-1_all.deb ${CTRL}
	rm -fdr ${CTRL} tmp
	dpkg -i rpi-eeprom-images_${EEPROM_VERSION}-1_all.deb rpi-eeprom_${EEPROM_VERSION}-1_all.deb
	cd ..
fi
rm -fdr eeprom
}
