install_brcm_firmware (){
echo ""
mkdir -p /lib/firmware/brcm
mkdir -p /lib/firmware/updates
# firmware-brcm80211_20241210-1+rpt3_all
BRCM_FW="https://github.com/pyavitz/firmware.git -b brcm"
git clone -q --depth=1 --filter=blob:none --sparse ${BRCM_FW} /lib/firmware/updates
cd /lib/firmware/updates
git sparse-checkout add brcm cypress
cd ~
mv fw-0a5c_21e8.hcd /lib/firmware/brcm/BCM20702A0-0a5c-21e8.hcd
cp /lib/firmware/brcm/BCM20702A0-0a5c-21e8.hcd /lib/firmware/brcm/BCM20702A1-0a5c-21e8.hcd
chown root:root /lib/firmware/brcm/BCM20702A1-0a5c-21e8.hcd
chown root:root /lib/firmware/brcm/BCM20702A0-0a5c-21e8.hcd
