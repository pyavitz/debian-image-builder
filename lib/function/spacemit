spacemit_uboot_download (){
if [[ -d "${FAMILY}-u-boot-${GIT_UBOOT_TAG}" ]]; then
	if [[ ! `git -C ${FAMILY}-u-boot-${GIT_UBOOT_TAG} remote -v | grep "${GIT_UBOOT_URL}"` ]]; then
		rm -fdr u-boot ${FAMILY}-u-boot-${GIT_UBOOT_TAG}; fi
fi
if [[ -d "${FAMILY}-u-boot-${GIT_UBOOT_TAG}" ]]; then
	echo -en "${FAMILY}-u-boot-${GIT_UBOOT_TAG}:"
	cd ${FAMILY}-u-boot-${GIT_UBOOT_TAG}
	make clean
	echo -en " Restoring"
	cd ..; cp -r ${FAMILY}-u-boot-${GIT_UBOOT_TAG} u-boot
	# replace board/spacemit/k1-x/k1-x.env
	if [[ -f "../${UBOOT_PATCHDIR}/${UBOOT_VERSION}/${FAMILY}/k1-x.env" ]] && [[ "u-boot/board/spacemit/k1-x/k1-x.env" ]]; then
		cp -f "../${UBOOT_PATCHDIR}/${UBOOT_VERSION}/${FAMILY}/k1-x.env" "u-boot/board/spacemit/k1-x/k1-x.env"
	fi
	echo -e ", done."
else
	git clone -c advice.detachedHead=false --depth=1 ${GIT_UBOOT_URL} -b ${GIT_UBOOT_TAG} ${FAMILY}-u-boot-${GIT_UBOOT_TAG}
	if [[ -d "${FAMILY}-u-boot-${GIT_UBOOT_TAG}" ]]; then
		cd ${FAMILY}-u-boot-${GIT_UBOOT_TAG}; make clean; cd ..; cp -r ${FAMILY}-u-boot-${GIT_UBOOT_TAG} u-boot
		# replace board/spacemit/k1-x/k1-x.env
		if [[ -f "../${UBOOT_PATCHDIR}/${UBOOT_VERSION}/${FAMILY}/k1-x.env" ]] && [[ "u-boot/board/spacemit/k1-x/k1-x.env" ]]; then
			cp -f "../${UBOOT_PATCHDIR}/${UBOOT_VERSION}/${FAMILY}/k1-x.env" "u-boot/board/spacemit/k1-x/k1-x.env"
		fi
	else
		echo -e "${RED}Download Failed!${FIN}"
		exit 1
	fi
fi
}

uboot_output (){
if [[ -f "bootinfo_emmc.bin" ]] && [[ -f "u-boot.itb" ]] && [[ -f "fw_dynamic.itb" ]] && [[ -f "FSBL.bin" ]]; then
	mkdir -p ../../${OUTPUT}
	cp -f bootinfo_emmc.bin ../../${OUTPUT}/
	cp -f FSBL.bin ../../${OUTPUT}/
	cp -f fw_dynamic.itb ../../${OUTPUT}/fw_dynamic.bin
	cp -f u-boot.itb ../../${OUTPUT}/u-boot.bin
	# add spi bins
	chmod o+r u-boot-env-default.bin
	cp -f bootinfo_spinor.bin ../../${OUTPUT}/
	cp -f u-boot-env-default.bin ../../${OUTPUT}/
	spacemit_spi_howto
	uboot_packaging
else
	report_error
fi
}

spacemit_uboot_compiler (){
# SpacemiT opensbi is not compat with gcc-15
if [[ "$HOST_CODENAME" == "resolute" ]]; then
	if [[ `dpkg -l | grep gcc-14-riscv64-linux-gnu` ]]; then :; else apt install -y gcc-14-riscv64-linux-gnu; sleep .25; fi
	COMPILER="gcc-14"
fi
}

spacemit_uboot_run (){
sources_dir
opensbi_firmware
uboot_run
uboot_output
}

spacemit_uboot_packaging (){
cp -f bootinfo_emmc.bin ${PKGNAME}_${PKGVERSION}-${BV}_${ARCH_EXT}/usr/lib/${PKGNAME}/
cp -f bootinfo_spinor.bin ${PKGNAME}_${PKGVERSION}-${BV}_${ARCH_EXT}/usr/lib/${PKGNAME}/
cp -f FSBL.bin ${PKGNAME}_${PKGVERSION}-${BV}_${ARCH_EXT}/usr/lib/${PKGNAME}/
cp -f fw_dynamic.itb ${PKGNAME}_${PKGVERSION}-${BV}_${ARCH_EXT}/usr/lib/${PKGNAME}/fw_dynamic.bin
cp -f u-boot.itb ${PKGNAME}_${PKGVERSION}-${BV}_${ARCH_EXT}/usr/lib/${PKGNAME}/u-boot.bin
cp -f u-boot-env-default.bin ${PKGNAME}_${PKGVERSION}-${BV}_${ARCH_EXT}/usr/lib/${PKGNAME}/
}

# LINUX
spacemit_extra_git_patching (){
# Drop in DTS
if [[ "$FORCE_GIT" == "true" ]] && [[ -d "../../${GIT_PATCHDIR}/dts" ]]; then
	if [[ `ls ../../${GIT_PATCHDIR}/dts/{Makefile,*.dts}` ]] > /dev/null 2>&1; then
		echo "# ${GIT_PATCHDIR}/dts" | sed -e 's/\(.*\)/\U\1/' >> ${LOG_FILE}
		ls ../../${GIT_PATCHDIR}/dts/*.dts* | sed 's/..\/..\///g' >> ${LOG_FILE}
		cp -fr ../../${GIT_PATCHDIR}/dts/*.dts* arch/${ARCH}/boot/dts/${PLATFORM}
		echo "" >> arch/${ARCH}/boot/dts/${PLATFORM}/Makefile
		cat ../../${GIT_PATCHDIR}/dts/Makefile >> arch/${ARCH}/boot/dts/${PLATFORM}/Makefile
	fi
fi
}

# STAGE1
flash_uboot (){
dd if=${OUTPUT}/bootinfo_emmc.bin of="${IMAGE_LOOP_DEV}" bs=512 conv=notrunc
dd if=${OUTPUT}/FSBL.bin of="${IMAGE_LOOP_DEV}" bs=512 seek=1 conv=notrunc
dd if=${OUTPUT}/fw_dynamic.bin of="${IMAGE_LOOP_DEV}" bs=512 seek=1280 conv=notrunc
dd if=${OUTPUT}/u-boot.bin of="${IMAGE_LOOP_DEV}" bs=512 seek=2048 conv=notrunc
}

spacemit_stage1_extra_firmware (){
if [[ "$FAMILY" == "spacemit" ]]; then
	mkdir -p ${P_VALUE}/lib/firmware
	cp -r files/firmware/spacemit/* ${P_VALUE}/lib/firmware
fi
}

