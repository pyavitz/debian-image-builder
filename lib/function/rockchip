# STAGE1
flash_uboot (){
if [[ "$UBOOT_RK_BIN" == "true" ]]; then
	dd if="${OUTPUT}/u-boot-rockchip.bin" of="${IMAGE_LOOP_DEV}" seek=64
else
	dd if="${OUTPUT}/idbloader.bin" of="${IMAGE_LOOP_DEV}" seek=64
	dd if="${OUTPUT}/u-boot.bin" of="${IMAGE_LOOP_DEV}" seek=16384
fi
}

# STAGE2
rockchip_extra_firmware (){
if [[ -f "/lib/firmware/brcm/brcmfmac4356-sdio.bin" ]] && [[ -f "/lib/firmware/brcm/brcmfmac4356-sdio.txt" ]]; then
	ln -s /lib/firmware/brcm/brcmfmac4356-sdio.bin /lib/firmware/brcm/brcmfmac4356-sdio.friendlyarm,nanopc-t4.bin
	ln -s /lib/firmware/brcm/brcmfmac4356-sdio.txt /lib/firmware/brcm/brcmfmac4356-sdio.friendlyarm,nanopc-t4.txt
fi
}

rockchip_bluetooth (){
if [[ "$BOARD" =~ ^(radxazero3w)$ ]]; then
	mv -f aic-bthelper /usr/local/sbin/bthelper
	chmod +x /usr/local/sbin/bthelper
	if [[ "$DISTRO" =~ ^(debian|ubuntu|kali)$ ]]; then aic_bt_service > /dev/null 2>&1; fi
fi
}

nanopir3s_udev_rules (){
echo '#SUBSYSTEM=="rtc", KERNEL=="rtc1", SYMLINK+="rtc" OPTIONS+="link_priority=-100"' | tee /etc/udev/rules.d/10-hym8563-rtc.rules
}