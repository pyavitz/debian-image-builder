#!/bin/bash

# ATF BINARY
atf_bl31 (){ # place bl31 file.
if [[ -f "../arm-trusted-firmware-${TAG}/build/${ATF_PLAT}/release/bl31/bl31.elf" ]]; then
	cp ../arm-trusted-firmware-${TAG}/build/${ATF_PLAT}/release/bl31/bl31.elf bl31.elf
	cp ../arm-trusted-firmware-${TAG}/build/${ATF_PLAT}/release/bl31/bl31.elf atf-bl31
else
		report_atf_error
fi
if [[ -f "${RKBIN_ELF}" ]] && [[ -f "../${RKBIN_DIR}/${RKBIN_RAM}" ]]; then
	export BL31="${RKBIN_ELF}"
	export ROCKCHIP_TPL="../${RKBIN_DIR}/${RKBIN_RAM}"
elif [[ -f "../${RKBIN_DIR}/${RKBIN_ELF}" ]] && [[ -f "../${RKBIN_DIR}/${RKBIN_RAM}" ]]; then
	export BL31="../${RKBIN_DIR}/${RKBIN_ELF}"
	export ROCKCHIP_TPL="../${RKBIN_DIR}/${RKBIN_RAM}"
else
		report_error
fi
}

# RKBIN RKBIN_COMMIT
rockchip_loader_binaries (){
GIT_RKBIN_URL="https://github.com/rockchip-linux/rkbin.git"
rkbin_download
}

# RKBIN DOWNLOAD
rkbin_download (){
if [[ `wget -S --spider https://github.com/rockchip-linux/rkbin/blob/master/README 2>&1 | grep 'HTTP/1.1 200 OK'` ]]; then
	if [[ -d "rkbin-${RKBIN_COMMIT}" ]]; then
		echo -en "${WHT}RKBIN ${RKBIN_COMMIT}${FIN}"
		echo -e " ${PNK}[${FIN}${YLW}found${FIN}${PNK}]${FIN}"
	else
		rm -fdr rkbin-*
		echo -en "${WHT}RKBIN ${RKBIN_COMMIT}${FIN}"
		echo -en " ${PNK}[${FIN}${WHT}cloning${FIN}${PNK}]${FIN}"
		git clone --depth=1 -q -c advice.detachedHead=false ${GIT_RKBIN_URL} rkbin-${RKBIN_COMMIT}
		if [[ -d "rkbin-${RKBIN_COMMIT}" ]]; then
			cd rkbin-${RKBIN_COMMIT}; git checkout -q ${RKBIN_COMMIT}; cd ..
			echo -e " ${PNK}[${FIN}${GRN}done${FIN}${PNK}]${FIN}"
		else
			echo -e " ${PNK}[${FIN}${RED}failed${FIN}${PNK}]${FIN}"
			exit 1
		fi
	fi
fi
}

# U-BOOT
rockchip_uboot_config (){
if [[ "$FAMILY_EXT" == "rk356x" ]] && [[ -f "configs/${UBOOT_DEFCONFIG}" ]]; then
	echo "CONFIG_BOOTMETH_SCRIPT=y" >> configs/${UBOOT_DEFCONFIG}
	echo "CONFIG_OF_LIBFDT_OVERLAY=y" >> configs/${UBOOT_DEFCONFIG}
	echo "CONFIG_DM_VIDEO=y" >> configs/${UBOOT_DEFCONFIG}
fi
}

uboot_output (){
if [[ "$UBOOT_RK_BIN" == "true" ]] && [[ -f "u-boot-rockchip.bin" ]]; then
	mkdir -p ../../${OUTPUT}
	cp -f u-boot-rockchip.bin ../../${OUTPUT}/
	uboot_packaging
	echo ""
elif [[ -f "idbloader.img" ]] && [[ -f "u-boot.itb" ]]; then
	mkdir -p ../../${OUTPUT}
	cp -f idbloader.img ../../${OUTPUT}/idbloader.bin
	cp -f u-boot.itb ../../${OUTPUT}/u-boot.bin
	uboot_packaging
	echo ""
else
	report_error
fi
}

rockchip_uboot_run (){
sources_dir
if [[ "$FAMILY_EXT" =~ ^(rk356x)$ ]]; then rockchip_loader_binaries; fi
arm_trusted_firmware
uboot_run
uboot_output
}

rockchip_uboot_packaging (){
if [[ "$UBOOT_RK_BIN" == "true" ]]; then
	cp -f u-boot-rockchip.bin ${PKGNAME}_${PKGVERSION}-${BV}_${ARCH_EXT}/usr/lib/${PKGNAME}/
else
	cp -f idbloader.img ${PKGNAME}_${PKGVERSION}-${BV}_${ARCH_EXT}/usr/lib/${PKGNAME}/idbloader.bin
	cp -f u-boot.itb ${PKGNAME}_${PKGVERSION}-${BV}_${ARCH_EXT}/usr/lib/${PKGNAME}/u-boot.bin
fi
}

# LINUX
rockchip_extra_patching (){
# rockchip: all
if [[ "$FAMILY" == "rockchip" ]] && [[ -d "../../${LINUX_PATCHDIR}/../all/${LINUX_VERSION}" ]]; then
	if [[ "$FAMILY_EXT" =~ ^(rk3288|rk3328|rk3399)$ ]]; then
		if [[ `ls ../../${LINUX_PATCHDIR}/../all/${LINUX_VERSION}/*.patch` ]] > /dev/null 2>&1; then
			echo "# ${LINUX_PATCHDIR}/../all/${LINUX_VERSION}" | sed -e 's/\(.*\)/\U\1/' >> ${LOG_FILE}
			for i in ../../${LINUX_PATCHDIR}/../all/${LINUX_VERSION}/*.patch; do patch -N -p1 < $i; done >> ${LOG_FILE}
		fi
	fi
fi
}

rockchip_extra_wireless (){
if [[ "$BOARD" == "radxazero3w" ]] && [[ -d "../../${WIRELESSPATCHES}/aic8800" ]]; then
	if [[ `ls ../../${WIRELESSPATCHES}/aic8800/*.patch` ]] > /dev/null 2>&1; then
		echo "# ${WIRELESSPATCHES}/aic8800" | sed -e 's/\(.*\)/\U\1/' >> ${LOG_FILE}
		for i in ../../${WIRELESSPATCHES}/aic8800/*.patch; do patch -N -p1 < $i; done >> ${LOG_FILE}
	fi
fi
}

# STAGE1
flash_uboot (){
if [[ "$UBOOT_RK_BIN" == "true" ]]; then
	dd if="${OUTPUT}/u-boot-rockchip.bin" of="${IMAGE_LOOP_DEV}" seek=64
else
	dd if="${OUTPUT}/idbloader.bin" of="${IMAGE_LOOP_DEV}" seek=64
	dd if="${OUTPUT}/u-boot.bin" of="${IMAGE_LOOP_DEV}" seek=16384
fi
}

# STAGE2
rockchip_extra_firmware (){
if [[ "$BOARD" == "radxazero3w" ]] && [[ -d "/lib/firmware/aic8800/SDIO/aic8800" ]] && [[ -d "/lib/firmware/aic8800/SDIO/aic8800D80" ]]; then
	mv /lib/firmware/aic8800/SDIO/aic8800 /lib/firmware/aic8800/SDIO/aic8800-orig
	ln -s /lib/firmware/aic8800/SDIO/aic8800D80 /lib/firmware/aic8800/SDIO/aic8800
fi
}
