From 3fac1357b3ee92b87ecb3629dcf447773f39bc30 Mon Sep 17 00:00:00 2001
From: Patrick Yavitz <pyavitz@gmail.com>
Date: Thu, 15 Jan 2026 09:06:50 -0500
Subject: [PATCH] Odroid N2: Enable usb start with a 2 second sleep

Signed-off-by: Patrick Yavitz <pyavitz@gmail.com>
---
 configs/odroid-n2_defconfig | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/configs/odroid-n2_defconfig b/configs/odroid-n2_defconfig
index 3b65e3fee21..1aa8574105e 100644
--- a/configs/odroid-n2_defconfig
+++ b/configs/odroid-n2_defconfig
@@ -21,6 +21,8 @@ CONFIG_FIT=y
 CONFIG_FIT_SIGNATURE=y
 CONFIG_FIT_VERBOSE=y
 CONFIG_OF_BOARD_SETUP=y
+CONFIG_USE_PREBOOT=y
+CONFIG_PREBOOT="usb start; sleep 2"
 # CONFIG_DISPLAY_CPUINFO is not set
 CONFIG_MISC_INIT_R=y
 CONFIG_SYS_MAXARGS=32
-- 
2.51.0

