From e9b3f707cd334be321b59419a59ef5502906034f Mon Sep 17 00:00:00 2001
From: Patrick Yavitz <pyavitz@gmail.com>
Date: Fri, 23 Jan 2026 09:19:08 -0500
Subject: [PATCH] Enable KASLR support

Signed-off-by: Patrick Yavitz <pyavitz@gmail.com>
---
 configs/h96max-x3_defconfig   | 2 ++
 configs/x96air-gbit_defconfig | 2 ++
 2 files changed, 4 insertions(+)

diff --git a/configs/h96max-x3_defconfig b/configs/h96max-x3_defconfig
index 6833b3d9564..32d806fef67 100644
--- a/configs/h96max-x3_defconfig
+++ b/configs/h96max-x3_defconfig
@@ -35,6 +35,8 @@ CONFIG_CMD_USB=y
 CONFIG_CMD_USB_MASS_STORAGE=y
 # CONFIG_CMD_SETEXPR is not set
 # CONFIG_CMD_CLS is not set
+CONFIG_CMD_RNG=y
+CONFIG_CMD_KASLRSEED=y
 CONFIG_CMD_REGULATOR=y
 CONFIG_CMD_BTRFS=y
 CONFIG_CMD_EXT4_WRITE=y
diff --git a/configs/x96air-gbit_defconfig b/configs/x96air-gbit_defconfig
index 866d12371ac..d90c0d72594 100644
--- a/configs/x96air-gbit_defconfig
+++ b/configs/x96air-gbit_defconfig
@@ -35,6 +35,8 @@ CONFIG_CMD_USB=y
 CONFIG_CMD_USB_MASS_STORAGE=y
 # CONFIG_CMD_SETEXPR is not set
 # CONFIG_CMD_CLS is not set
+CONFIG_CMD_RNG=y
+CONFIG_CMD_KASLRSEED=y
 CONFIG_CMD_REGULATOR=y
 CONFIG_CMD_BTRFS=y
 CONFIG_CMD_EXT4_WRITE=y
