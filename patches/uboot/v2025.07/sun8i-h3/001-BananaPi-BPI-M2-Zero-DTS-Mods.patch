From 2aaaf9196e37d2bbf9af0e23a95027167853d77c Mon Sep 17 00:00:00 2001
From: Patrick Yavitz <pyavitz@gmail.com>
Date: Wed, 3 Sep 2025 11:38:07 -0400
Subject: [PATCH] BananaPi BPI-M2-Zero DTS Mods

Signed-off-by: Patrick Yavitz <pyavitz@gmail.com>
---
 arch/arm/dts/sun8i-h2-plus-bananapi-m2-zero.dts | 8 +++++---
 1 file changed, 5 insertions(+), 3 deletions(-)

diff --git a/arch/arm/dts/sun8i-h2-plus-bananapi-m2-zero.dts b/arch/arm/dts/sun8i-h2-plus-bananapi-m2-zero.dts
index d3a7c9fa23e..89b315727d8 100644
--- a/arch/arm/dts/sun8i-h2-plus-bananapi-m2-zero.dts
+++ b/arch/arm/dts/sun8i-h2-plus-bananapi-m2-zero.dts
@@ -12,6 +12,7 @@
 
 #include <dt-bindings/gpio/gpio.h>
 #include <dt-bindings/input/input.h>
+#include <dt-bindings/leds/common.h>
 
 / {
 	model = "Banana Pi BPI-M2-Zero";
@@ -40,10 +41,11 @@
 	leds {
 		compatible = "gpio-leds";
 
-		pwr_led {
-			label = "bananapi-m2-zero:red:pwr";
+		led-0 {
+			color = <LED_COLOR_ID_RED>;
+			function = LED_FUNCTION_STATUS;
 			gpios = <&r_pio 0 10 GPIO_ACTIVE_LOW>; /* PL10 */
-			default-state = "on";
+			linux,default-trigger = "heartbeat";
 		};
 	};
 
-- 
