From 90a55432271e036b851fc7c9250364bf625af89e Mon Sep 17 00:00:00 2001
From: Patrick Yavitz <pyavitz@gmail.com>
Date: Thu, 28 May 2026 13:36:01 -0400
Subject: [PATCH] Update SpacemiT K3 defconfig

Signed-off-by: Patrick Yavitz <pyavitz@gmail.com>
---
 configs/k3_defconfig | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/configs/k3_defconfig b/configs/k3_defconfig
index 9c63a83322..0f14060436 100644
--- a/configs/k3_defconfig
+++ b/configs/k3_defconfig
@@ -24,6 +24,9 @@ CONFIG_ARCH_RV64I=y
 CONFIG_RISCV_SMODE=y
 # CONFIG_RISCV_ISA_C is not set
 # CONFIG_SPL_SMP is not set
+CONFIG_LOCALVERSION=" SpacemiT K3"
+CONFIG_LOCALVERSION_AUTO=n
+CONFIG_DISTRO_DEFAULTS=y
 CONFIG_ENV_VARS_UBOOT_CONFIG=y
 CONFIG_HAS_CUSTOM_SYS_INIT_SP_ADDR=y
 CONFIG_CUSTOM_SYS_INIT_SP_ADDR=0x102300000
@@ -37,11 +40,11 @@ CONFIG_SPL_FIT_IMAGE_POST_PROCESS=y
 # CONFIG_LEGACY_IMAGE_FORMAT is not set
 CONFIG_SUPPORT_RAW_INITRD=y
 CONFIG_OF_BOARD_SETUP=y
-CONFIG_BOOTDELAY=0
+CONFIG_BOOTDELAY=2
 CONFIG_AUTOBOOT_KEYED=y
 CONFIG_AUTOBOOT_STOP_STR="s"
 CONFIG_USE_BOOTCOMMAND=y
-CONFIG_LOGLEVEL=7
+CONFIG_LOGLEVEL=1
 CONFIG_SPL_LOGLEVEL=1
 # CONFIG_SYS_DEVICE_NULLDEV is not set
 CONFIG_DISPLAY_CPUINFO=y
@@ -278,3 +281,4 @@ CONFIG_SPL_LZO=y
 # CONFIG_GENERATE_SMBIOS_TABLE is not set
 CONFIG_EFI_VARIABLE_NO_STORE=y
 CONFIG_LMB_MAX_REGIONS=32
+CONFIG_OF_LIBFDT_OVERLAY=y
-- 
