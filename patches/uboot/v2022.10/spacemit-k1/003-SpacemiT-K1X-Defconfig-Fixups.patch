From e7f7dfd5c51ef1466f33f6a06ffa79bed979161f Mon Sep 17 00:00:00 2001
From: Patrick Yavitz <pyavitz@gmail.com>
Date: Mon, 23 Mar 2026 19:17:23 -0400
Subject: [PATCH] SpacemiT K1X Defconfig Fixups

Signed-off-by: Patrick Yavitz <pyavitz@gmail.com>
---
 configs/k1_defconfig | 16 +++++++++-------
 1 file changed, 9 insertions(+), 7 deletions(-)

diff --git a/configs/k1_defconfig b/configs/k1_defconfig
index c3d8806e..7dc4b48e 100644
--- a/configs/k1_defconfig
+++ b/configs/k1_defconfig
@@ -24,7 +24,9 @@ CONFIG_K1_X_BOARD_ASIC=y
 CONFIG_ARCH_RV64I=y
 CONFIG_RISCV_SMODE=y
 # CONFIG_SPL_SMP is not set
-CONFIG_LOCALVERSION="spacemit"
+CONFIG_LOCALVERSION=" SpacemiT"
+CONFIG_LOCALVERSION_AUTO=n
+CONFIG_DISTRO_DEFAULTS=y
 CONFIG_ENV_VARS_UBOOT_CONFIG=y
 CONFIG_HAS_CUSTOM_SYS_INIT_SP_ADDR=y
 CONFIG_CUSTOM_SYS_INIT_SP_ADDR=0x1000000
@@ -36,12 +38,8 @@ CONFIG_SPL_LOAD_FIT_ADDRESS=0x08000000
 CONFIG_LEGACY_IMAGE_FORMAT=y
 CONFIG_SUPPORT_RAW_INITRD=y
 CONFIG_OF_BOARD_SETUP=y
-CONFIG_BOOTDELAY=0
-CONFIG_AUTOBOOT_KEYED=y
-CONFIG_AUTOBOOT_STOP_STR="s"
-CONFIG_USE_BOOTCOMMAND=y
 CONFIG_BOOTCOMMAND="bootm 0x08000000"
-CONFIG_LOGLEVEL=7
+CONFIG_LOGLEVEL=1
 CONFIG_SPL_LOGLEVEL=1
 # CONFIG_SYS_DEVICE_NULLDEV is not set
 CONFIG_DISPLAY_CPUINFO=y
@@ -114,6 +112,8 @@ CONFIG_CMD_PXE=y
 CONFIG_CMD_BMP=y
 CONFIG_CMD_TIME=y
 CONFIG_CMD_GETTIME=y
+CONFIG_CMD_RNG=y
+CONFIG_CMD_KASLRSEED=y
 CONFIG_CMD_TIMER=y
 CONFIG_CMD_SYSBOOT=y
 CONFIG_CMD_EXT4_WRITE=y
@@ -211,7 +211,7 @@ CONFIG_SPI_FLASH_GIGADEVICE=y
 CONFIG_SPI_FLASH_WINBOND=y
 CONFIG_SPI_FLASH_FM=y
 CONFIG_SPINOR_BLOCK_SUPPORT=y
-# CONFIG_SPI_FLASH_USE_4K_SECTORS is not set
+CONFIG_SPI_FLASH_USE_4K_SECTORS=y
 CONFIG_SPI_FLASH_MTD=y
 CONFIG_PHY_REALTEK=y
 CONFIG_SPACEMIT_K1X_EMAC=y
@@ -236,6 +236,7 @@ CONFIG_SPL_SPACEMIT_POWER=y
 CONFIG_DM_PWM=y
 CONFIG_PWM_PXA=y
 CONFIG_RESET_SPACEMIT_K1X=y
+CONFIG_DM_RNG=y
 # CONFIG_SCSI is not set
 # CONFIG_DM_SCSI is not set
 CONFIG_SYS_NS16550_IER=0x40
@@ -296,3 +297,4 @@ CONFIG_PRINT_TIMESTAMP=y
 CONFIG_ZSTD=y
 CONFIG_SPL_LZO=y
 # CONFIG_HEXDUMP is not set
+CONFIG_OF_LIBFDT_OVERLAY=y
-- 
2.53.0

