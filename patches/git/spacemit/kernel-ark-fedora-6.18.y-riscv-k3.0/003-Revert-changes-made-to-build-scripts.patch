-"
-
-SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
-SOURCE_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
-SOURCE_PARENT_DIR="$(cd "$SOURCE_DIR/.." && pwd)"
