@@ -1,318 +0,0 @@
-#!/bin/bash -e
-
-PACKAGE_SRC_NAME="linux-riscv-spacemit-generic"
-CONFIG_FILE="k3_bianbu_defconfig"
-CLEAN_CMD="make distclean && make -C tools/perf clean &&
