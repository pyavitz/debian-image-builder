-    VERSION=\$(grep -oP '^VERSION\\s*=\\s*\\K\\d+' Makefile)
-    PATCHLEVEL=\$(grep -oP '^PATCHLEVEL\\s*=\\s*\\K\\d+' Makefile)
-    SUBLEVEL=\$(grep -oP '^SUBLEVEL\\s*=\\s*\\K\\d+' Makefile)
