From ce8a557cd08cd26b315f9092e933b58762c2d816 Mon Sep 17 00:00:00 2001
From: Patrick Yavitz <pyavitz@gmail.com>
Date: Wed, 18 Jun 2025 08:42:06 -0400
Subject: [PATCH] Radxa Zero 3: Overclock to 2.0GHz

Signed-off-by: Patrick Yavitz <pyavitz@gmail.com>
---
 arch/arm64/boot/dts/rockchip/rk3566-radxa-zero-3.dtsi | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/arch/arm64/boot/dts/rockchip/rk3566-radxa-zero-3.dtsi b/arch/arm64/boot/dts/rockchip/rk3566-radxa-zero-3.dtsi
index 0b9a1c3e22d9..70ef07759a8f 100644
--- a/arch/arm64/boot/dts/rockchip/rk3566-radxa-zero-3.dtsi
+++ b/arch/arm64/boot/dts/rockchip/rk3566-radxa-zero-3.dtsi
@@ -435,6 +435,15 @@ regulator-state-mem {
 	};
 };
 
+&cpu0_opp_table {
+	opp-2016000000 {
+		opp-hz = /bits/ 64 <2016000000>;
+		opp-microvolt = <1150000 1150000 1150000>;
+		clock-latency-ns = <40000>;
+		turbo-mode;
+	};
+};
+
 &i2s0_8ch {
 	status = "okay";
 };
-- 
2.43.0

