From 4655ce60a440808658148fdaac4e2e9a84fc2834 Mon Sep 17 00:00:00 2001
From: Patrick Yavitz <pyavitz@gmail.com>
Date: Mon, 18 Aug 2025 06:02:30 -0400
Subject: [PATCH] Radxa Zero 3w add antenna

Signed-off-by: Patrick Yavitz <pyavitz@gmail.com>
---
 .../dts/rockchip/rk3566-radxa-zero-3w.dts     | 21 +++++++++++++++++++
 1 file changed, 21 insertions(+)

diff --git a/arch/arm64/boot/dts/rockchip/rk3566-radxa-zero-3w.dts b/arch/arm64/boot/dts/rockchip/rk3566-radxa-zero-3w.dts
index f92475c59deb..1952a8be526e 100644
--- a/arch/arm64/boot/dts/rockchip/rk3566-radxa-zero-3w.dts
+++ b/arch/arm64/boot/dts/rockchip/rk3566-radxa-zero-3w.dts
@@ -14,6 +14,16 @@ aliases {
 		mmc2 = &sdmmc1;
 	};
 
+	board_antenna: board-antenna {
+		compatible = "regulator-fixed";
+		enable-active-low;
+		pinctrl-0 = <&ant_1>;
+		pinctrl-names = "default";
+		regulator-always-on;
+		regulator-boot-on;
+		regulator-name = "board-antenna";
+	};
+
 	sdio_pwrseq: sdio-pwrseq {
 		compatible = "mmc-pwrseq-simple";
 		clocks = <&rk817 1>;
@@ -27,6 +37,12 @@ sdio_pwrseq: sdio-pwrseq {
 };
 
 &pinctrl {
+	antenna {
+		ant_1: ant-1 {
+			rockchip,pins = <3 RK_PD2 RK_FUNC_GPIO &pcfg_pull_down>;
+		};
+	};
+
 	bluetooth {
 		bt_reg_on_h: bt-reg-on-h {
 			rockchip,pins = <0 RK_PC1 RK_FUNC_GPIO &pcfg_pull_none>;
@@ -52,6 +68,11 @@ wifi_wake_host_h: wifi-wake-host-h {
 	};
 };
 
+&board_antenna {
+	gpio = <&gpio3 RK_PD2 GPIO_ACTIVE_LOW>;
+	status = "disabled";
+};
+
 &sdhci {
 	bus-width = <8>;
 	cap-mmc-highspeed;
-- 
2.43.0

