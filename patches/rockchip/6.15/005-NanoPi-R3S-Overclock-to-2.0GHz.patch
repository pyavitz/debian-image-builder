From 7a56da605eac3bb34fdf014e7cd22fee2e19bc8f Mon Sep 17 00:00:00 2001
From: Patrick Yavitz <pyavitz@gmail.com>
Date: Wed, 18 Jun 2025 08:48:04 -0400
Subject: [PATCH] NanoPi R3S: Overclock to 2.0GHz

Signed-off-by: Patrick Yavitz <pyavitz@gmail.com>
---
 arch/arm64/boot/dts/rockchip/rk3566-nanopi-r3s.dts | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/arch/arm64/boot/dts/rockchip/rk3566-nanopi-r3s.dts b/arch/arm64/boot/dts/rockchip/rk3566-nanopi-r3s.dts
index 413daa2468b2..d1dc546c64f3 100644
--- a/arch/arm64/boot/dts/rockchip/rk3566-nanopi-r3s.dts
+++ b/arch/arm64/boot/dts/rockchip/rk3566-nanopi-r3s.dts
@@ -136,6 +136,15 @@ &cpu3 {
 	cpu-supply = <&vdd_cpu>;
 };
 
+&cpu0_opp_table {
+	opp-2016000000 {
+		opp-hz = /bits/ 64 <2016000000>;
+		opp-microvolt = <1150000 1150000 1150000>;
+		clock-latency-ns = <40000>;
+		turbo-mode;
+	};
+};
+
 &gmac1 {
 	phy-mode = "rgmii";
 	clock_in_out = "output";
-- 
2.43.0

