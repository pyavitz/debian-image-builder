From 5d40669783303be66565a7457f3b293a1764236d Mon Sep 17 00:00:00 2001
From: Patrick Yavitz <pyavitz@gmail.com>
Date: Thu, 19 Jun 2025 08:01:48 -0400
Subject: [PATCH] Radxa Zero 3: Overclock to 2.0GHz

Signed-off-by: Patrick Yavitz <pyavitz@gmail.com>
---
 arch/arm64/boot/dts/rockchip/rk3566-radxa-zero-3.dtsi | 11 ++++++++++-
 1 file changed, 10 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/rockchip/rk3566-radxa-zero-3.dtsi b/arch/arm64/boot/dts/rockchip/rk3566-radxa-zero-3.dtsi
index 0b9a1c3e22d9..6946be161d1f 100644
--- a/arch/arm64/boot/dts/rockchip/rk3566-radxa-zero-3.dtsi
+++ b/arch/arm64/boot/dts/rockchip/rk3566-radxa-zero-3.dtsi
@@ -3,7 +3,7 @@
 #include <dt-bindings/gpio/gpio.h>
 #include <dt-bindings/leds/common.h>
 #include <dt-bindings/soc/rockchip,vop2.h>
-#include "rk3566t.dtsi"
+#include "rk3566.dtsi"
 
 / {
 	chosen {
@@ -105,6 +105,15 @@ &cpu3 {
 	cpu-supply = <&vdd_cpu>;
 };
 
+&cpu0_opp_table {
+	opp-2016000000 {
+		opp-hz = /bits/ 64 <2016000000>;
+		opp-microvolt = <1150000 1150000 1150000>;
+		clock-latency-ns = <40000>;
+		turbo-mode;
+	};
+};
+
 &gpio0 {
 	gpio-line-names =
 		/* GPIO0_A0 - A7 */
-- 
2.43.0

