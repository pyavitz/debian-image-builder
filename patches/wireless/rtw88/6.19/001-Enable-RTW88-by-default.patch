 config RTW88_8723DS
 	tristate "Realtek 8723DS SDIO wireless network adapter"
 	depends on MMC
+	default m
 	select RTW88_CORE
 	select RTW88_SDIO
 	select RTW88_8723D
@@ -148,6 +157,7 @@ config RTW88_8723DS
 config RTW88_8723CS
 	tristate "Realtek 8723CS SDIO wireless network adapter"
 	depends on MMC
+	default m
 	select RTW88_CORE
 	select RTW88_SDIO
 	select RTW88_8703B
@@ -162,6 +172,7 @@ config RTW88_8723CS
 config RTW88_8723DU
 	tristate "Realtek 8723DU USB wireless network adapter"
 	depends on USB
+	default m
 	select RTW88_CORE
 	select RTW88_USB
 	select RTW88_8723D
@@ -173,6 +184,7 @@ config RTW88_8723DU
 config RTW88_8821CE
 	tristate "Realtek 8821CE PCI wireless network adapter"
 	depends on PCI
+	default m
 	select RTW88_CORE
 	select RTW88_PCI
