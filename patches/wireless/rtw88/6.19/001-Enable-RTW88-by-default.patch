@@ -217,6 +232,7 @@ config RTW88_8821AU
 config RTW88_8812AU
 	tristate "Realtek 8812AU USB wireless network adapter"
 	depends on USB
+	default m
 	select RTW88_CORE
 	select RTW88_USB
