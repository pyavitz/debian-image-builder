Date: Wed, 9 Apr 2025 05:59:07 -0400
Subject: [PATCH] Enable RTW88 by default

Signed-off-by: Patrick Yavitz <pyavitz@gmail.com>
---
 drivers/net/wireless/realtek/rtw88/Kconfig | 18 ++++++++++++++++++
 1 file changed, 18 insertions(+)

diff --git a/drivers/net/wireless/realtek/rtw88/Kconfig b/drivers/net/wireless/realtek/rtw88/Kconfig
index 3736f290bd42..d23f8fee44de 100644
--- a/drivers/net/wireless/realtek/rtw88/Kconfig
+++ b/drivers/net/wireless/realtek/rtw88/Kconfig
@@ -2,6 +2,7 @@
 menuconfig RTW88
 	tristate "Realtek 802.11ac wireless chips support"
 	depends on MAC80211
+	default m
 	help
 	  This module adds support for mac80211-based wireless drivers that
 	  enables Realtek IEEE 802.11ac wireless chipsets.
@@ -60,6 +61,7 @@ config RTW88_8814A
 config RTW88_8822BE
 	tristate "Realtek 8822BE PCI wireless network adapter"
 	depends on PCI
+	default m
 	select RTW88_CORE
 	select RTW88_PCI
 	select RTW88_8822B
@@ -71,6 +73,7 @@ config RTW88_8822BE
 config RTW88_8822BS
 	tristate "Realtek 8822BS SDIO wireless network adapter"
 	depends on MMC
+	default m
 	select RTW88_CORE
 	select RTW88_SDIO
 	select RTW88_8822B
@@ -82,6 +85,7 @@ config RTW88_8822BS
 config RTW88_8822BU
 	tristate "Realtek 8822BU USB wireless network adapter"
 	depends on USB
+	default m
 	select RTW88_CORE
 	select RTW88_USB
 	select RTW88_8822B
@@ -93,6 +97,7 @@ config RTW88_8822BU
 config RTW88_8822CE
 	tristate "Realtek 8822CE PCI wireless network adapter"
 	depends on PCI
+	default m
 	select RTW88_CORE
 	select RTW88_PCI
 	select RTW88_8822C
@@ -104,6 +109,7 @@ config RTW88_8822CE
 config RTW88_8822CS
 	tristate "Realtek 8822CS SDIO wireless network adapter"
 	depends on MMC
+	default m
 	select RTW88_CORE
 	select RTW88_SDIO
 	select RTW88_8822C
@@ -115,6 +121,7 @@ config RTW88_8822CS
