trixie-ncompile (){
if [[ "$HOST_ARCH" =~ ^(aarch64)$ ]]; then
	sudo debconf-apt-progress -- apt install -y \
		build-essential bison bc git dialog patch dosfstools zip unzip parted \
		debootstrap qemu-user-static rsync kmod cpio flex libssl-dev libncurses5-dev \
		device-tree-compiler libfdt-dev python3-dev swig fakeroot mmdebstrap fdisk \
		lzop lz4 aria2 pv gcc-arm-none-eabi distro-info-data lsb-release u-boot-tools \
		python-is-python3 python-dev-is-python3 python3-distutils-extra libelf-dev kpartx \
		crossbuild-essential-armhf crossbuild-essential-armel gcc-arm-linux-gnueabihf \
		gcc-arm-linux-gnueabi colorized-logs gdisk jq wget btrfs-progs xfsprogs dh-python \
		python3-setuptools python3-pyelftools curl libgnutls28-dev uuu uuid-dev mtools xxd \
		gcc-14-plugin-dev figlet gcc-or1k-elf gcc-riscv64-linux-gnu clang ccache xz-utils zstd gcc \
		debhelper libdw-dev
elif [[ "$HOST_ARCH" =~ ^(riscv64)$ ]]; then
	sudo debconf-apt-progress -- apt install -y \
		build-essential bison bc git dialog patch dosfstools zip unzip parted \
		debootstrap qemu-user-static rsync kmod cpio flex libssl-dev libncurses5-dev \
		device-tree-compiler libfdt-dev python3-dev swig fakeroot mmdebstrap fdisk \
		lzop lz4 aria2 pv distro-info-data lsb-release u-boot-tools \
		python-is-python3 python-dev-is-python3 python3-distutils-extra libelf-dev kpartx \
		colorized-logs gdisk jq wget btrfs-progs xfsprogs dh-python \
		python3-setuptools python3-pyelftools curl libgnutls28-dev uuu uuid-dev mtools xxd \
		gcc-14-plugin-dev figlet gcc-or1k-elf clang ccache xz-utils zstd gcc \
		debhelper libdw-dev
fi
}

