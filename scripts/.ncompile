resolute-ncompile (){
if [[ "$HOST_ARCH" =~ ^(aarch64)$ ]]; then
	sudo debconf-apt-progress -- apt install -y \
		build-essential bison bc git dialog patch make dosfstools zip unzip \
		debootstrap qemu-user-binfmt rsync libelf-dev kmod cpio flex \
		libssl-dev libncurses5-dev parted device-tree-compiler libfdt-dev \
		python3-dev swig fakeroot lzop lz4 aria2 pv u-boot-tools \
		gcc-arm-none-eabi distro-info-data lsb-release zstd xxd \
		python-dev-is-python3 kpartx debian-archive-keyring debian-keyring \
		python3-setuptools python3-distutils-extra fdisk mmdebstrap \
		dh-python python-is-python3 colorized-logs gdisk jq wget btrfs-progs xfsprogs \
		python3-pyelftools curl libgnutls28-dev uuu uuid-dev mtools figlet gcc-or1k-elf \
		crossbuild-essential-armhf gcc-arm-linux-gnueabi gcc-14-plugin-dev gcc-15-plugin-dev \
		gcc-arm-linux-gnueabihf libelf-dev gcc gcc-14 ccache gcc-riscv64-linux-gnu \
		debhelper binfmt-support libdw-dev
elif [[ "$HOST_ARCH" =~ ^(riscv64)$ ]]; then
	sudo debconf-apt-progress -- apt install -y \
		build-essential bison bc git dialog patch make dosfstools zip unzip \
		debootstrap qemu-user-binfmt rsync libelf-dev kmod cpio flex lsb-release \
		libssl-dev libncurses5-dev parted device-tree-compiler libfdt-dev \
		python3-dev swig fakeroot lzop lz4 aria2 pv u-boot-tools distro-info-data \
		python-dev-is-python3 kpartx debian-archive-keyring debian-keyring \
		python3-setuptools python3-distutils-extra fdisk mmdebstrap zstd xxd \
		dh-python python-is-python3 colorized-logs gdisk jq wget btrfs-progs xfsprogs \
		python3-pyelftools curl libgnutls28-dev uuu uuid-dev mtools figlet gcc-or1k-elf \
		gcc-15-plugin-dev libelf-dev gcc ccache debhelper binfmt-support libdw-dev
fi
}

if [[ "$HOST_ARCH" == "x86_64" ]]; then
	echo ""
	echo -e "You are running: $HOST_ARCH"
	echo -e "Please run: make ccompile"
	exit 0
fi

if [[ "$HOST_CODENAME" =~ ^(bullseye|bookworm|trixie|jammy|noble|resolute)$ ]]; then
	echo ""
	${HOST_CODENAME}-ncompile
	# Fixup Ubuntu Resolute binfmt support
	if [[ "$HOST_CODENAME" =~ ^(resolute)$ ]]; then
		# make sure the qemu-$arch.conf file is linked.
		BINFMT_LIB_DIR="/usr/lib/binfmt.d"
		BINFMT_SHARE_DIR="/usr/share/qemu/binfmt.d"
		if [[ ! -f "${BINFMT_LIB_DIR}/qemu-arm.conf" ]] && [[ -f "${BINFMT_SHARE_DIR}/qemu-arm.conf" ]]; then
			sudo ln -sv "${BINFMT_SHARE_DIR}/qemu-arm.conf" "${BINFMT_LIB_DIR}/qemu-arm.conf"
		fi
		if [[ ! -f "${BINFMT_LIB_DIR}/qemu-riscv64.conf" ]] && [[ -f "${BINFMT_SHARE_DIR}/qemu-riscv64.conf" ]]; then
			sudo ln -sv "${BINFMT_SHARE_DIR}/qemu-riscv64.conf" "${BINFMT_LIB_DIR}/qemu-riscv64.conf"
		fi
		sudo apt install -y binfmt-support qemu-user qemu-user-binfmt --reinstall
	fi
else
	echo -e ""
	echo -e "Something went wrong..?"
	exit 0
fi

exit 0
