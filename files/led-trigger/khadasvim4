#!/bin/bash

LED1="status"
ROOT_SATA=`findmnt -v -n -o SOURCE / | sed 's/.$//'`
ROOT_SSD=`findmnt -v -n -o SOURCE / | sed 's/..$//'`

if [ -f "/sys/class/leds/${LED1}/trigger" ]; then
	WHITE_LED="/sys/class/leds/${LED1}/trigger"
	if [[ -e "$WHITE_LED" ]]; then
		ROOT_DEVICE=`findmnt -v -n -o SOURCE /`
		ROOT_DEVICE=${ROOT_DEVICE/\/dev\//}
		ROOT_DEVICE=${ROOT_DEVICE/mmcblk/mmc}
		ROOT_DEVICE=${ROOT_DEVICE/p[0-9]/}
		echo -n "$ROOT_DEVICE" > $WHITE_LED
	fi
	if [[ -e "$WHITE_LED" ]]; then
		if [[ "$ROOT_SSD" == "/dev/nvme0n1" ]]; then echo -n "none" > $WHITE_LED; fi
		if [[ "$ROOT_SATA" == "/dev/sda" || "$ROOT_SATA" == "/dev/sdb" ]]; then echo -n "none" > $WHITE_LED; fi
	fi
fi

exit 0
